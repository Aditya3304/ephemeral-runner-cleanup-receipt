#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"
export GOTOOLCHAIN=local
export CGO_ENABLED=0

image='postgres:17.11-bookworm@sha256:051f7b7b3abdd564d5d1bd1e8c4b9c1b6e77087d1dd22020ede611c096a272e0'
build() {
  mkdir -p .build
  go build -trimpath -o .build/dbtool ./cmd/dbtool
  go test -c -trimpath -o .build/db.test ./db
}
case "${1:-help}" in
  ci-prepare) bash scripts/ci-prepare.sh ;;
  ci-build) bash scripts/runner-build.sh ;;
  ci-up) bash scripts/kind-up.sh; bash scripts/policy-up.sh ;;
  ci-demo) python3 scripts/demo-ci.py pass fail ;;
  ci-check) python3 scripts/demo-ci.py ;;
  guard-check)
    export PATH="$PWD/.build/node-v24.20.0-linux-x64/bin:$PATH"
    npm run check --workspace action --offline
    GOPROXY=off GOSUMDB=off go test -p 2 ./internal/coordinator ./cmd/localci
    ;;
  cli-prepare) bash scripts/prepare-cli.sh ;;
  cli-build) GOPROXY=off GOSUMDB=off go build -p 2 -trimpath -o .build/proofctl ./cmd/proofctl ;;
  cli-check)
    export PROOF_COSIGN="$PWD/.build/cosign"
    GOPROXY=off GOSUMDB=off go test -p 2 -count=1 -v ./internal/proof ./cmd/proofctl
    ;;
  kind-up) bash scripts/kind-up.sh ;;
  cli-demo) python3 scripts/demo-cli.py ;;
  kind-check)
    export PROOF_KIND_CONFIG="$PWD/.build/kubeconfig"
    GOPROXY=off GOSUMDB=off go test -p 2 -count=1 -v -run '^TestKindCleanup$' -timeout 180s ./internal/proof
    ;;
  prepare)
    docker pull "$image"
    go mod download
    build
    echo 'Setup assets cached. Use bash dev up for offline database startup.'
    ;;
  build) GOPROXY=off GOSUMDB=off build ;;
  up)
    [[ -x .build/dbtool ]] || { echo 'Run bash dev prepare first.' >&2; exit 1; }
    docker image inspect "$image" >/dev/null
    docker compose run --rm --no-deps bootstrap
    docker compose up -d --wait --wait-timeout 90 db
    docker compose run --rm tools /app/dbtool migrate
    docker compose run --rm tools /app/dbtool status
    ;;
  check)
    GOPROXY=off GOSUMDB=off build
    docker compose run --rm tools /app/db.test -test.v -test.timeout=120s
    ;;
  status) docker compose run --rm tools /app/dbtool status ;;
  demo) docker compose run --rm tools /app/dbtool demo ;;
  stop) docker compose stop db ;;
  *)
    echo 'Local database foundation (WSL/Linux). No hosted workflows.'
    echo 'bash dev prepare  Download pinned setup assets and build tools (internet required).'
    echo 'bash dev up       Start local PostgreSQL and migrate (no downloads).'
    echo 'bash dev check    Test a separate temporary database; preserve the main database.'
    echo 'bash dev demo     Show a synthetic metadata transaction, then roll it back.'
    echo 'bash dev status   Show TLS, version, migration and real table counts.'
    echo 'bash dev stop     Stop PostgreSQL and preserve all volumes.'
    echo 'bash dev cli-prepare  Prepare pinned CLI tools (initial download).'
    echo 'bash dev cli-build    Build proofctl with cached dependencies.'
    echo 'bash dev cli-check    Filesystem, ownership and offline Sigstore checks.'
    echo 'bash dev kind-up      Create/preserve the dedicated project cluster.'
    echo 'bash dev kind-check   Run real Kubernetes cleanup tests.'
    echo 'bash dev cli-demo     Create, inventory, clean and inspect a real local run.'
    echo 'bash dev ci-prepare   Cache Node, guard dependencies, policy and runner images (setup).'
    echo 'bash dev ci-build     Build and preload the pinned local runner (cached dependencies).'
    echo 'bash dev ci-up        Check/start the local cluster and network policy controller.'
    echo 'bash dev ci-demo      Run passing and failing jobs with automatic cleanup.'
    echo 'bash dev ci-check     Run the real lifecycle and isolation checks.'
    echo 'bash dev guard-check Test guard lifecycle and coordinator trust boundaries.'
    ;;
esac
