{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion",
        "s3:GetObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::receipt-archive/evidence/sha256/*"
      ]
    },
    {
      "Effect": "Deny",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::receipt-archive/evidence/sha256/*"],
      "Condition": {"StringEquals": {"s3:versionid": ""}}
    }
  ]
}
