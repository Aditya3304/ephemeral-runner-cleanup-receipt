{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectRetention",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::receipt-archive/evidence/sha256/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObjectRetention"],
      "Resource": ["arn:aws:s3:::receipt-archive/evidence/sha256/*"],
      "Condition": {"StringEquals": {"s3:object-lock-mode": "COMPLIANCE"}}
    }
  ]
}
